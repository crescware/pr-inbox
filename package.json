{
  "name": "pr-inbox",
  "version": "0.0.0",
  "description": "指定ユーザーの Open PR を、stack ツリーと同じ順序のレビュー状況一覧でターミナルに表示する",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crescware/pr-inbox.git"
  },
  "bin": {
    "pr-inbox": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
